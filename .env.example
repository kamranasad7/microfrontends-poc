# Per-MFE deploy URLs. Leave unset for localhost defaults.
#
# Each MFE's vite.config calls mfeUrl(name, defaultPort) in tools/vite-mfe.ts,
# which reads `${NAME}_URL` from process.env or falls back to the localhost
# port. Set these at build/deploy time (CI / host config / shell).
#
# QUIZZES_URL=https://quizzes.juicemind.app
# STUDENTS_URL=https://students.juicemind.app
# HEADER_URL=https://header.juicemind.app
# SETTINGS_URL=https://settings.juicemind.app
# AUTH_URL=https://auth.juicemind.app
