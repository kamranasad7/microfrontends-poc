# --- microfrontend deploy URLs ---
# Each MFE's vite.config calls mfeUrl(name, defaultPort) in tools/vite-mfe.ts,
# which reads `${NAME}_URL` from process.env or falls back to the localhost
# port. Set these at build/deploy time (CI / host config / shell).
#
# QUIZZES_URL=https://quizzes.example.com
# STUDENTS_URL=https://students.example.com
# HEADER_URL=https://header.example.com
# SETTINGS_URL=https://settings.example.com
# AUTH_URL=https://auth.example.com

# --- microservice URLs ---
# Each microservice and its MFE clients read `${NAME}_API_URL` via
# serviceUrl(name, defaultPort) in tools/service-env.ts. MFE side reads via
# Vite as VITE_<NAME>_API_URL (define'd from the Node env at build time).
#
# AUTH_API_URL=https://auth-api.example.com
# NOTIFICATIONS_API_URL=https://notifications-api.example.com
# QUIZZES_API_URL=https://quizzes-api.example.com
# STUDENTS_API_URL=https://students-api.example.com

# --- microservice config ---
# Shared HS256 secret. Required in prod. Dev default is hardcoded in
# tools/service-env.ts. Set to a long random string for any non-trivial deploy.
# JWT_SECRET=change-me-in-prod
#
# Comma-separated CORS allowlist. If unset, services default to
# localhost:5173 (host) + their primary MFE's standalone dev origin.
# ALLOWED_ORIGINS=https://app.example.com
